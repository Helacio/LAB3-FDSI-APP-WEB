[Unit]
Description=MuvAutomation backend (Go + MongoDB + RabbitMQ)
Documentation=https://github.com/lab3-fdsi
After=network-online.target mongod.service rabbitmq-server.service
Wants=network-online.target
Requires=mongod.service rabbitmq-server.service

[Service]
Type=simple
User=muvautomation
Group=muvautomation
WorkingDirectory=/opt/muvautomation
Environment=PORT=8080
Environment=MONGO_URI=mongodb://127.0.0.1:27017
Environment=MONGO_DB=muvautomation
Environment=BROKER_URL=amqp://guest:guest@127.0.0.1:5672/
Environment=STATUS_WORKERS=4
Environment=STATUS_INTERVAL=60s
ExecStart=/opt/muvautomation/muvbackend
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
